# ── Active Provider ───────────────────────────────────────────────────────────
# Switch provider + model by changing just these two lines. That's it.
#
#  Provider          | LLM_PROVIDER        | Example LLM_MODEL
#  ──────────────────┼─────────────────────┼──────────────────────────────────
#  OpenAI            | openai              | gpt-4o / gpt-4o-mini / o1-mini
#  Anthropic         | anthropic           | claude-3-5-sonnet-20241022
#  Google Gemini     | google_genai        | gemini-1.5-pro / gemini-1.5-flash
#  Groq (fast/free)  | groq                | llama-3.3-70b-versatile
#  Ollama (local)    | ollama              | llama3 / mistral (no key needed)
#
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# ── API Keys (only the one matching LLM_PROVIDER is required) ─────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...
# Ollama → no key needed, just set LLM_PROVIDER=ollama and LLM_MODEL=llama3

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
